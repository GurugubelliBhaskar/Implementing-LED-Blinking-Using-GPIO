#include "stm32f4xx.h"
int main(void){
//enable clock to port a and port c
RCC->AHB1ENR|=(5<<0);
// select port A5 th pin as output
GPIOA->MODER&=~(3<<10);
	GPIOA->MODER|=(1<<10);
// select port C13 th pin as input
	GPIOC->MODER&=~(3<<26);
while(1){
// switch ON PA5
	GPIOA->ODR|=(1<<5);
	for(double i=0;i<500000;i++);
// switch OFF PA5
	GPIOA->ODR&=~(1<<5);
	for(double i=0;i<500000;i++);
}
}
